@page "/board"
@attribute [Authorize]
@using Vanadium.Note.Web.Components
@inject NoteService NoteService
@inject PropertyService PropertyService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<Board> Logger
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<PageTitle>Board</PageTitle>

<div class="board-page">
    <div class="board-top-bar">
        <div class="board-group-selector">
            <span class="board-group-label">Group by:</span>
            @if (!selectProperties.Any())
            {
                <span class="board-no-properties">
                    No Select properties yet. Create one on the <a href="/properties">Properties</a> page.
                </span>
            }
            else
            {
                @foreach (var def in selectProperties)
                {
                    var defId = def.Id;
                    <button class="board-group-btn @(groupDefinitionId == defId ? "active" : "")"
                            @onclick="() => SelectGroupProperty(defId)">
                        @def.Name
                    </button>
                }
            }
        </div>
        <PropertyFilterBar Filters="propertyFilters" OnChanged="OnPropertyFiltersChanged" />
    </div>

    @if (isLoading && !notes.Any())
    {
        <p class="board-loading-msg">Loading...</p>
    }
    else if (groupDefinition is null || !groupDefinition.Options.Any())
    {
        <p class="board-empty-msg">
            @if (!selectProperties.Any())
            {
                <span>No Select property found. Create one on the Properties page first.</span>
            }
            else
            {
                <span>This property has no options.</span>
            }
        </p>
    }
    else
    {
        <div class="board-columns">
            @foreach (var option in groupDefinition.Options.OrderBy(o => o.SortOrder).ThenBy(o => o.Name))
            {
                var columnOption = option;
                var notesForOption = GetNotesForOption(columnOption.Id);
                var isExpanded = expandedColumns.Contains(columnOption.Id);
                var visibleNotes = isExpanded ? notesForOption : notesForOption.Take(CardsPerColumnLimit).ToList();
                var hiddenCount = notesForOption.Count - visibleNotes.Count;

                <div class="board-column"
                     data-option-id="@columnOption.Id">
                    <div class="board-column-header">
                        <span class="board-column-title">@columnOption.Name</span>
                        <span class="board-column-count">@notesForOption.Count</span>
                    </div>
                    <div class="board-column-cards">
                        @foreach (var note in visibleNotes)
                        {
                            var capturedNote = note;
                            <div class="board-card"
                                 draggable="true"
                                 data-note-id="@capturedNote.Id"
                                 data-option-id="@columnOption.Id"
                                 @onclick="() => EditNote(capturedNote.Id)">
                                <div class="board-card-header">
                                    <div class="board-card-title">
                                        @(string.IsNullOrWhiteSpace(capturedNote.Title) ? "(No title)" : capturedNote.Title)
                                    </div>
                                    @* Touch fallback for HTML5 drag-drop (#273): a menu button that opens the
                                       "move to column" sheet, since dragstart/drop never fire on touch. *@
                                    <button class="board-card-move"
                                            type="button"
                                            draggable="false"
                                            title="Move to another column"
                                            aria-label="Move to another column"
                                            @onclick="() => OpenMoveSheet(capturedNote, columnOption.Id)"
                                            @onclick:stopPropagation="true">
                                        &#8942;
                                    </button>
                                </div>
                                @OtherPropertyChips(capturedNote)
                                <div class="board-card-date">
                                    @capturedNote.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")
                                </div>
                            </div>
                        }
                    </div>
                    @if (hiddenCount > 0)
                    {
                        <div class="board-column-showmore">
                            <button class="board-showmore-btn" @onclick="() => ShowMore(columnOption.Id)">
                                Show @hiddenCount more
                            </button>
                        </div>
                    }
                    <div class="board-column-footer">
                        <button class="board-add-btn" @onclick="() => OpenAddDialog(columnOption)">
                            + Add a note
                        </button>
                    </div>
                </div>
            }

            @{
                var unclassifiedNotes = GetUnclassifiedNotes();
            }
            @if (unclassifiedNotes.Any())
            {
                // "No value" virtual column: notes carrying no value for the grouping property. It is
                // not a drop TARGET — it has no data-option-id, so drag-drop never resolves it as a
                // column and dropping onto it cannot clear a value (#272). Its cards ARE drag
                // SOURCES though: dragging one onto an option column sets that option on the note
                // with the same single write as any other move (#375). The cards carry no
                // data-option-id either, so the drag reports "no source option" (null).
                var unclassifiedExpanded = expandedColumns.Contains(UnclassifiedColumnKey);
                var unclassifiedVisible = unclassifiedExpanded ? unclassifiedNotes : unclassifiedNotes.Take(CardsPerColumnLimit).ToList();
                var unclassifiedHidden = unclassifiedNotes.Count - unclassifiedVisible.Count;

                <div class="board-column board-column-unclassified">
                    <div class="board-column-header">
                        <span class="board-column-title">No value</span>
                        <span class="board-column-count">@unclassifiedNotes.Count</span>
                    </div>
                    <div class="board-column-cards">
                        @foreach (var note in unclassifiedVisible)
                        {
                            var capturedNote = note;
                            <div class="board-card"
                                 draggable="true"
                                 data-note-id="@capturedNote.Id"
                                 @onclick="() => EditNote(capturedNote.Id)">
                                <div class="board-card-header">
                                    <div class="board-card-title">
                                        @(string.IsNullOrWhiteSpace(capturedNote.Title) ? "(No title)" : capturedNote.Title)
                                    </div>
                                    @* Touch fallback (#273/#375): the kebab sheet is the only way to assign a
                                       value on touch, where dragstart/drop never fire. No source option here. *@
                                    <button class="board-card-move"
                                            type="button"
                                            draggable="false"
                                            title="Move to another column"
                                            aria-label="Move to another column"
                                            @onclick="() => OpenMoveSheet(capturedNote, null)"
                                            @onclick:stopPropagation="true">
                                        &#8942;
                                    </button>
                                </div>
                                @OtherPropertyChips(capturedNote)
                                <div class="board-card-date">
                                    @capturedNote.UpdatedAt.ToLocalTime().ToString("MM-dd HH:mm")
                                </div>
                            </div>
                        }
                    </div>
                    @if (unclassifiedHidden > 0)
                    {
                        <div class="board-column-showmore">
                            <button class="board-showmore-btn" @onclick="() => ShowMore(UnclassifiedColumnKey)">
                                Show @unclassifiedHidden more
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@if (showDialog)
{
    <div class="board-dialog-overlay" @onclick="CancelDialog">
        <div class="board-dialog"
             role="dialog"
             aria-modal="true"
             aria-label="Add a note"
             @ref="_dialogRef"
             @onclick:stopPropagation="true">
            <div class="board-dialog-header">
                <h4>New note in &ldquo;<strong>@dialogOption?.Name</strong>&rdquo;</h4>
                <button class="board-dialog-close" @onclick="CancelDialog">×</button>
            </div>
            <input class="board-dialog-input"
                   type="text"
                   placeholder="Note title"
                   @ref="_dialogInput"
                   @bind="newNoteTitle"
                   @bind:event="oninput"
                   @onkeydown="OnDialogKeyDown" />
            @if (string.IsNullOrWhiteSpace(newNoteTitle))
            {
                <div class="board-dialog-hint">Title is empty — will be saved as <em>(No title)</em></div>
            }
            @if (dialogError is not null)
            {
                <div class="board-dialog-error">@dialogError</div>
            }
            <div class="board-dialog-footer">
                <button class="btn btn-outline-secondary btn-sm" @onclick="CancelDialog" disabled="@isAdding">Cancel</button>
                <button class="btn btn-primary btn-sm" @onclick="ConfirmAddNote" disabled="@isAdding">
                    @(isAdding ? "Adding..." : "Add")
                </button>
            </div>
        </div>
    </div>
}

@* Move sheet: touch-friendly fallback (#273) to change a card's column when HTML5
   drag-drop is unavailable. Lists the grouping property's options; tapping one moves
   the note via the same persistence path as a desktop drop. It also carries the only
   "No value" (clear the value) action on the board: once every note has a value the
   virtual "No value" column is not rendered at all, so there is no column to drag a
   card back into — the sheet entry is what keeps clearing reachable (#375 review). *@
@if (showMoveSheet)
{
    <div class="board-dialog-overlay" @onclick="CloseMoveSheet">
        <div class="board-dialog board-move-sheet"
             role="dialog"
             aria-modal="true"
             aria-label="Move note to another column"
             @onclick:stopPropagation="true">
            <div class="board-dialog-header">
                <h4>Move &ldquo;<strong>@moveNoteTitle</strong>&rdquo; to</h4>
                <button class="board-dialog-close" @onclick="CloseMoveSheet">×</button>
            </div>
            <div class="board-move-options">
                @foreach (var opt in moveSheetOptions)
                {
                    var targetId = opt.Id;
                    var isCurrent = targetId == moveFromOptionId;
                    <button class="board-move-option @(isCurrent ? "current" : "")"
                            disabled="@isCurrent"
                            @onclick="() => MoveViaSheet(targetId)">
                        <span class="board-move-option-name">@opt.Name</span>
                        @if (isCurrent)
                        {
                            <span class="board-move-option-badge">Current</span>
                        }
                    </button>
                }
                @{
                    var hasNoValue = moveFromOptionId is null;
                }
                <button class="board-move-option board-move-option-clear @(hasNoValue ? "current" : "")"
                        disabled="@hasNoValue"
                        @onclick="ClearViaSheet">
                    <span class="board-move-option-name">No value</span>
                    @if (hasNoValue)
                    {
                        <span class="board-move-option-badge">Current</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    // Cap the cards initially rendered per column so a property with many notes
    // does not grow the board's DOM/render cost without bound (#206). The rest
    // stay reachable behind a per-column "Show more" toggle.
    private const int CardsPerColumnLimit = 50;

    // Sentinel key for the "No value" virtual column in expandedColumns. Real option ids
    // are never Guid.Empty, so it can never collide with an actual column (#272).
    private static readonly Guid UnclassifiedColumnKey = Guid.Empty;

    private IReadOnlyList<NoteSummary> notes = [];
    // Every definition (needed to resolve card chips of any type); the board can only group by
    // the Select subset.
    private List<PropertyDefinition> allDefinitions = [];
    private List<PropertyDefinition> selectProperties = [];
    private readonly List<PropertyFilter> propertyFilters = [];
    private Guid? groupDefinitionId;
    private bool isLoading = false;
    // Option ids whose column has been expanded past CardsPerColumnLimit.
    private readonly HashSet<Guid> expandedColumns = [];
    private DotNetObjectReference<Board>? _dotNetRef;

    // ── Dialog state ──────────────────────────────────────────────────────────
    private bool showDialog = false;
    private PropertyOption? dialogOption;
    private string newNoteTitle = "";
    private string? dialogError;
    private bool isAdding = false;
    private ElementReference _dialogRef;
    private ElementReference _dialogInput;
    private bool _trapQueued;

    // ── Move sheet state (touch fallback for HTML5 drag-drop, #273) ───────────
    private bool showMoveSheet = false;
    private Guid moveNoteId;
    // null when the sheet was opened from a "No value" card — no option is the current one (#375).
    private Guid? moveFromOptionId;
    private string moveNoteTitle = "";
    private IReadOnlyList<PropertyOption> moveSheetOptions = [];

    private PropertyDefinition? groupDefinition =>
        selectProperties.FirstOrDefault(d => d.Id == groupDefinitionId);

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var defResult = await PropertyService.GetDefinitionsAsync();
        if (!defResult.IsSuccess)
            Snackbar.Add(defResult.Error ?? "Failed to load properties.", Severity.Error);
        allDefinitions = defResult.Value ?? [];
        // Columns come from a single-valued Select: a note sits in exactly one column, which is what
        // makes a drag a plain "set this note's value" write. MultiSelect would put one note in
        // several columns at once and has no single-source-of-truth column to move it out of.
        selectProperties = allDefinitions
            .Where(d => d.Type == PropertyType.Select)
            .OrderBy(d => d.SortOrder).ThenBy(d => d.Name)
            .ToList();
        if (selectProperties.Any())
        {
            groupDefinitionId = selectProperties[0].Id;
            await LoadNotesForCurrentGroup();
        }
        isLoading = false;
    }

    private async Task OnPropertyFiltersChanged() => await LoadNotesForCurrentGroup();

    private async Task LoadNotesForCurrentGroup()
    {
        // A fresh load collapses every column back to the cap.
        expandedColumns.Clear();
        if (groupDefinition is null || !groupDefinition.Options.Any())
        {
            notes = [];
            isLoading = false;
            return;
        }
        isLoading = true;
        StateHasChanged();
        // Load every non-archived note (no filter on the grouping property) so notes with no value
        // for it are available client-side for the "No value" virtual column (#272). Filtering
        // server-side on the grouping property would drop them entirely, hiding them from the board.
        var notesResult = await NoteService.GetAllSummariesAsync(
            propertyFilters: propertyFilters.Count > 0 ? propertyFilters : null);
        if (!notesResult.IsSuccess)
            Snackbar.Add(notesResult.Error ?? "Failed to load notes.", Severity.Error);
        notes = notesResult.Value ?? [];
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("boardDragDrop.init", _dotNetRef);
        }

        if (_trapQueued)
        {
            _trapQueued = false;
            await JS.InvokeVoidAsync("focusTrap.activate", _dialogRef);
            try { await _dialogInput.FocusAsync(); } catch { /* dialog may have closed */ }
        }
    }

    // ── Called by JS when a card is dropped on a different column ─────────────

    /// <summary><paramref name="fromOptionIdStr"/> is null for a card dragged out of the "No value"
    /// column — the note simply has no value for the grouping property yet (#375). It is reported
    /// for logging only; the move itself is the same single set-value write either way.</summary>
    [JSInvokable]
    public async Task OnDropFromJs(string noteIdStr, string? fromOptionIdStr, string toOptionIdStr)
    {
        if (!Guid.TryParse(noteIdStr, out var noteId)) return;
        if (!Guid.TryParse(toOptionIdStr, out var toOptionId)) return;
        Guid? fromOptionId = Guid.TryParse(fromOptionIdStr, out var parsedFrom) ? parsedFrom : null;
        await MoveNoteToOptionAsync(noteId, fromOptionId, toOptionId);
    }

    // Shared move logic used by both the desktop HTML5 drop (OnDropFromJs) and the
    // touch move sheet (MoveViaSheet / ClearViaSheet) so every path persists identically (#273).
    // A null fromOptionId means the note had no value for the grouping property, i.e. it came
    // from the "No value" column (#375); assigning a value is the same single write as a move.
    // A null toOptionId means the value is being CLEARED — the note moves back to "No value"
    // (#375 review). Clearing is only reachable from the move sheet, never from a drop: the
    // "No value" column carries no data-option-id and is not rendered at all once every note
    // has a value, so a drop target for it cannot be relied on.
    private async Task MoveNoteToOptionAsync(Guid noteId, Guid? fromOptionId, Guid? toOptionId)
    {
        var definition = groupDefinition;
        if (definition is null) return;

        // Resolve target option from the current grouping property (skipped when clearing)
        if (toOptionId is { } targetId && !definition.Options.Any(o => o.Id == targetId))
        {
            Logger.LogWarning("Drop target option {OptionId} not found on property {DefinitionId}.",
                targetId, definition.Id);
            return;
        }

        var note = notes.FirstOrDefault(n => n.Id == noteId);

        // Snapshot the note's property values before mutation for rollback. The optimistic update
        // below never mutates an existing NotePropertyValue in place — it replaces or removes the
        // entry — so this shallow list copy is a faithful snapshot to restore on failure.
        var originalProperties = note?.Properties.ToList();

        // Optimistic update — move card immediately
        if (note is not null)
        {
            note.Properties.RemoveAll(p => p.DefinitionId == definition.Id);
            if (toOptionId is { } newOptionId)
                note.Properties.Add(new NotePropertyValue
                {
                    DefinitionId = definition.Id,
                    Name = definition.Name,
                    Type = PropertyType.Select,
                    OptionId = newOptionId
                });
        }

        StateHasChanged();

        Logger.LogInformation("Moving note {NoteId} on property {DefinitionId}: option {FromOption} → {ToOption}.",
            noteId, definition.Id, fromOptionId, toOptionId);

        // Persist with a SINGLE write. A Select value holds exactly one option, so setting the target
        // both clears the old column and fills the new one atomically. A separate clear-then-set would
        // leave a window where a mid-move failure strips the value and drops the note out of every
        // column; the single set has no such partial-failure mode — on failure the server is unchanged
        // and the note keeps its original option (#271). Clearing is likewise one DELETE.
        bool isSuccess;
        bool isForbidden;
        if (toOptionId is { } optionId)
        {
            var setResult = await PropertyService.SetValueAsync(
                noteId, definition.Id, new SetNotePropertyValueRequest { OptionId = optionId });
            (isSuccess, isForbidden) = (setResult.IsSuccess, setResult.IsForbidden);
        }
        else
        {
            var clearResult = await PropertyService.ClearValueAsync(noteId, definition.Id);
            (isSuccess, isForbidden) = (clearResult.IsSuccess, clearResult.IsForbidden);
        }

        if (!isSuccess)
        {
            Logger.LogError(
                "Failed to persist property move for note {NoteId} ({FromOption} → {ToOption}).",
                noteId, fromOptionId, toOptionId);

            // Immediate visual rollback before server sync
            if (note is not null && originalProperties is not null)
            {
                note.Properties = originalProperties;
                StateHasChanged();
            }

            // Reload from server to guarantee UI matches DB
            await LoadNotesForCurrentGroup();
            Snackbar.Add(
                isForbidden
                    ? "That note is archived and is read-only. Changes have been reverted."
                    : toOptionId is null
                        ? "Failed to clear the value. Changes have been reverted."
                        : "Failed to move note. Changes have been reverted.",
                Severity.Error);
        }
    }

    // ── General helpers ───────────────────────────────────────────────────────

    private List<NoteSummary> GetNotesForOption(Guid optionId) =>
        notes.Where(n => OptionIdFor(n) == optionId)
             .OrderByDescending(n => n.UpdatedAt)
             .ToList();

    // Notes with no value for the grouping property — surfaced in the "No value" virtual
    // column so unclassified notes are not invisible on the board (#272).
    private List<NoteSummary> GetUnclassifiedNotes()
    {
        if (groupDefinition is null)
            return [];
        var optionIds = groupDefinition.Options.Select(o => o.Id).ToHashSet();
        return notes.Where(n => OptionIdFor(n) is not { } id || !optionIds.Contains(id))
                    .OrderByDescending(n => n.UpdatedAt)
                    .ToList();
    }

    /// <summary>The note's selected option for the grouping property, or null when it has no value.
    /// Value rows only exist when non-empty (INV-P1), so a missing entry means "no value".</summary>
    private Guid? OptionIdFor(NoteSummary note) =>
        groupDefinitionId is { } defId
            ? note.Properties.FirstOrDefault(p => p.DefinitionId == defId)?.OptionId
            : null;

    // The card shows the note's OTHER non-empty property values as chips, so a board grouped by
    // "Status" still surfaces "Priority", "Due date", etc. without a second fetch — the values
    // already ride along on NoteSummary.Properties.
    private RenderFragment? OtherPropertyChips(NoteSummary note)
    {
        var others = note.Properties
            .Where(p => p.DefinitionId != groupDefinitionId)
            .Select(p => (Value: p, Text: PropertyValueFormatter.Format(
                allDefinitions.FirstOrDefault(d => d.Id == p.DefinitionId), p)))
            .Where(x => !string.IsNullOrEmpty(x.Text))
            .ToList();
        if (others.Count == 0) return null;

        return @<div class="board-card-props">
            @foreach (var (value, text) in others)
            {
                <span class="board-card-chip">
                    <span class="board-card-chip-prefix">@value.Name:</span>
                    @text
                </span>
            }
        </div>;
    }

    private void ShowMore(Guid optionId) => expandedColumns.Add(optionId);

    private async Task SelectGroupProperty(Guid definitionId)
    {
        groupDefinitionId = definitionId;
        await LoadNotesForCurrentGroup();
    }

    private void EditNote(Guid id) =>
        Nav.NavigateTo($"/editor/{id}?returnUrl=/board");

    // ── Move sheet (touch fallback for HTML5 drag-drop, #273) ─────────────────

    private void OpenMoveSheet(NoteSummary note, Guid? fromOptionId)
    {
        moveNoteId = note.Id;
        moveFromOptionId = fromOptionId;
        moveNoteTitle = string.IsNullOrWhiteSpace(note.Title) ? "(No title)" : note.Title;
        moveSheetOptions = groupDefinition?.Options.OrderBy(o => o.SortOrder).ThenBy(o => o.Name).ToList() ?? [];
        showMoveSheet = true;
    }

    private void CloseMoveSheet()
    {
        showMoveSheet = false;
        moveSheetOptions = [];
    }

    private async Task MoveViaSheet(Guid toOptionId)
    {
        var noteId = moveNoteId;
        var fromOptionId = moveFromOptionId;
        CloseMoveSheet();
        if (toOptionId == fromOptionId) return;
        await MoveNoteToOptionAsync(noteId, fromOptionId, toOptionId);
    }

    /// <summary>Clears the grouping property's value, sending the note back to the "No value"
    /// column. This is the only way to unset it from the board: the "No value" column is not a
    /// drop target, and once every note has a value it is not rendered at all, so there would
    /// otherwise be nothing to drag a card back into (#375 review).</summary>
    private async Task ClearViaSheet()
    {
        var noteId = moveNoteId;
        var fromOptionId = moveFromOptionId;
        CloseMoveSheet();
        if (fromOptionId is null) return;
        await MoveNoteToOptionAsync(noteId, fromOptionId, toOptionId: null);
    }

    // ── Add note dialog ───────────────────────────────────────────────────────

    private void OpenAddDialog(PropertyOption option)
    {
        dialogOption = option;
        newNoteTitle = "";
        dialogError = null;
        isAdding = false;
        showDialog = true;
        _trapQueued = true;
    }

    private async Task CancelDialog()
    {
        if (isAdding) return;
        showDialog = false;
        dialogOption = null;
        newNoteTitle = "";
        dialogError = null;
        await JS.InvokeVoidAsync("focusTrap.deactivate");
    }

    private async Task ConfirmAddNote()
    {
        if (dialogOption is null || groupDefinition is null || isAdding) return;

        isAdding = true;
        dialogError = null;
        StateHasChanged();

        try
        {
            var note = new NoteItem { Id = Guid.Empty, Title = newNoteTitle.Trim() };
            var saveResult = await NoteService.SaveAsync(note);
            if (saveResult.IsSuccess)
            {
                // The board places a new note into a column purely via its property value. Ignoring
                // the value PUT result left a saved-but-valueless note showing in the "No value"
                // column, so it looked like it vanished from the column it was created in (#205).
                var valueResult = await PropertyService.SetValueAsync(
                    saveResult.Value!.Id, groupDefinition.Id,
                    new SetNotePropertyValueRequest { OptionId = dialogOption.Id });
                if (!valueResult.IsSuccess)
                {
                    Logger.LogError(
                        "Note {NoteId} created but failed to set property '{PropertyName}' to '{OptionName}' from board dialog.",
                        saveResult.Value!.Id, groupDefinition.Name, dialogOption.Name);
                    Snackbar.Add(
                        $"Note saved, but couldn't be added to \"{dialogOption.Name}\". It appears under \"No value\".",
                        Severity.Warning);
                }
                await LoadNotesForCurrentGroup();
                showDialog = false;
                dialogOption = null;
                newNoteTitle = "";
                await JS.InvokeVoidAsync("focusTrap.deactivate");
            }
            else
            {
                Logger.LogError("Failed to create note from board dialog (option '{OptionName}').",
                    dialogOption.Name);
                dialogError = "Failed to add note. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error creating note from board dialog.");
            dialogError = "Failed to add note. Please try again.";
        }
        finally
        {
            isAdding = false;
        }
    }

    private async Task OnDialogKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmAddNote();
        else if (e.Key == "Escape") await CancelDialog();
    }

    public async ValueTask DisposeAsync()
    {
        if (showDialog)
            await JS.InvokeVoidAsync("focusTrap.deactivate");
        await JS.InvokeVoidAsync("boardDragDrop.dispose");
        _dotNetRef?.Dispose();
    }
}
