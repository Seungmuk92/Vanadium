# tiptap-markdown@0.9.0 declares a peer of @tiptap/core@^3, but the editor stack
# is intentionally pinned to the Tiptap 2.x line. The former CDN setup forced the
# same pairing via esm.sh's "?deps=@tiptap/core@2" override, so this combination
# is the one the app has always run. legacy-peer-deps reproduces that faithfully
# and keeps `npm ci` deterministic.
legacy-peer-deps=true
save-exact=true
